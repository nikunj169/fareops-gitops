{
  "uid": "fareops-main",
  "title": "FareOps - self-healing model",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Requests/s by model version", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (model_version) (rate(fare_api_requests_total{status=\"200\"}[1m]))", "legendFormat": "v{{model_version}}"}]},
    {"id": 2, "type": "timeseries", "title": "Live MAE (USD) by model version", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (model_version) (rate(fare_api_abs_error_usd_sum[2m])) / sum by (model_version) (rate(fare_api_abs_error_usd_count[2m]))", "legendFormat": "v{{model_version}}"}]},
    {"id": 3, "type": "timeseries", "title": "Feature drift (PSI, alert above 0.2)", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "max by (feature) (fare_api_feature_psi)", "legendFormat": "{{feature}}"}]},
    {"id": 4, "type": "timeseries", "title": "p95 latency (s) by model version", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, model_version) (rate(fare_api_request_latency_seconds_bucket[2m])))", "legendFormat": "v{{model_version}}"}]},
    {"id": 5, "type": "timeseries", "title": "Pods per model version", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "count by (model_version) (fare_api_model_info)", "legendFormat": "v{{model_version}}"}]},
    {"id": 6, "type": "timeseries", "title": "5xx ratio", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "(sum(rate(fare_api_requests_total{status=~\"5..\"}[2m])) or vector(0)) / sum(rate(fare_api_requests_total[2m]))", "legendFormat": "5xx"}]},
    {"id": 7, "type": "stat", "title": "Champion model version", "gridPos": {"x": 0, "y": 24, "w": 8, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "max(loop_champion_version)"}]},
    {"id": 8, "type": "timeseries", "title": "Loop events", "gridPos": {"x": 8, "y": 24, "w": 8, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "expr": "sum by (result) (loop_retrain_triggers_total)", "legendFormat": "trigger {{result}}"},
       {"refId": "B", "expr": "sum(loop_promotions_total)", "legendFormat": "promotions"},
       {"refId": "C", "expr": "sum(loop_rollbacks_total)", "legendFormat": "rollbacks"}]},
    {"id": 9, "type": "timeseries", "title": "Drift alert firing", "gridPos": {"x": 16, "y": 24, "w": 8, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "ALERTS{alertname=\"FareModelDrift\", alertstate=\"firing\"}", "legendFormat": "{{feature}}"}]}
  ]
}
